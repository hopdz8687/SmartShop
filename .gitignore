# =============================================================================
# SmartShop Root .gitignore
# =============================================================================

# --- Environment Variables & Sensitive Data ---
.env
.env.local
.env.*.local
*.env
application-local.properties
application-local.yml

# --- Node.js & React / Vite Frontend ---
node_modules/
dist/
dist-ssr/
*.local
.eslintcache
.stylelintcache

# --- Java & Spring Boot / Maven Backend ---
target/
**/target/
!**/src/main/**/target/
!**/src/test/**/target/
build/
**/build/
!**/src/main/**/build/
!**/src/test/**/build/
*.class
*.jar
!**/.mvn/wrapper/maven-wrapper.jar
*.war
*.ear
*.nar
HELP.md

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Antigravity / VS Code ---
.vscode/
!.vscode/extensions.json
.gemini/

# --- IntelliJ IDEA ---
.idea/
*.iws
*.iml
*.ipr
out/

# --- Eclipse / Spring Tool Suite (STS) ---
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# --- OS & Miscellaneous Editor Files ---
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
